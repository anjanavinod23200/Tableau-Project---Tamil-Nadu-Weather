      </column>
      <column caption='Rain Tomorrow Forecast' datatype='string' name='[Calculation_1123490083504129]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Rain_tomorrow] = 1 THEN&#13;&#10;    &quot;Rain Tomorrow&quot;&#13;&#10;ELSE&#13;&#10;    &quot;No Rain Tomorrow&quot;&#13;&#10;END' />
