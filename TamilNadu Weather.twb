      </column>
      <column caption='Average Humidity' datatype='real' name='[Calculation_1006666093682689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Relative_humidity_2m])' />
      </column>
      <column caption='Total Precipitation' datatype='real' name='[Calculation_1006666093793282]' role='measure' type='quantitative'>
