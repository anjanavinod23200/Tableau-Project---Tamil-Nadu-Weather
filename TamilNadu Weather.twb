      <column caption='Average Cloud Cover' datatype='real' name='[Calculation_1006666093998084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Cloud_cover])' />
      </column>
      <column caption='Rain Tomorrow Count' datatype='integer' name='[Calculation_1006666095280134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Rain_tomorrow] = 1 THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Rain Probability' datatype='real' default-format='p0.00%' name='[Calculation_1006666096435207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1006666095280134]/COUNT([Rain_tomorrow])' />
      </column>
      <column caption='Average Cloud Cover low' datatype='real' name='[Calculation_1123490082127872]' role='measure' type='quantitative'>
